---
import CTA from './CTA.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { breadcrumbSchema, SITE_ORIGIN, webPageSchema } from '../lib/seo';

interface Props {
  settings: Record<string, any>;
  page: Record<string, any>;
  serviceName: string;
  description: string;
  benefits: string[];
  path: string;
}

const { settings, page, serviceName, description, benefits, path } = Astro.props;
const seoTitle = page.seoTitle || `${serviceName} Mansfield TX | ${settings.businessName}`;
const seoDescription = page.seoDescription || description;
const schema = [
  webPageSchema('WebPage', seoTitle, seoDescription, path),
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    '@id': `${new URL(path, SITE_ORIGIN).href}#service`,
    name: serviceName,
    description: seoDescription,
    serviceType: serviceName,
    provider: { '@id': `${SITE_ORIGIN}/#business` },
    areaServed: {
      '@type': 'City',
      name: 'Mansfield',
      containedInPlace: { '@type': 'State', name: 'Texas' },
    },
    url: new URL(path, SITE_ORIGIN).href,
  },
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: serviceName, path },
  ]),
];
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  settings={settings}
  socialImage="/og.png"
  socialImageAlt={`${settings.businessName} — Mansfield, Texas`}
  schema={schema}
>
  <section class="page-hero property-page-hero">
    <div>
      <p class="eyebrow">{page.eyebrow}</p>
      <h1>{page.headline}</h1>
      <p>{page.intro}</p>
    </div>
    <img src={page.imageUrl} alt={page.imageAlt || ''} width="1200" height="800" />
  </section>
  <section class="section split property-service-body">
    <div>
      <p class="eyebrow">Serving Mansfield, Texas</p>
      <h2>{page.bodyHeading}</h2>
      <p>{page.bodyCopy}</p>
    </div>
    <ul class="feature-list">
      {benefits.map((benefit) => <li>{benefit}</li>)}
    </ul>
  </section>
  <CTA settings={settings} title={`Plan your ${serviceName.toLowerCase()} project.`} />
</BaseLayout>
