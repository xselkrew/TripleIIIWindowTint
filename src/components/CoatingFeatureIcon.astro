---
interface Props {
  feature: string;
}

const { feature } = Astro.props;
const normalized = feature.toLowerCase();

const kind =
  /9h|hardness|scratch|chip/.test(normalized) ? 'hardness'
  : /hydro|water/.test(normalized) ? 'water'
  : /gloss|mirror|shine/.test(normalized) ? 'gloss'
  : /self.clean|extended durability/.test(normalized) ? 'refresh'
  : /maintenance|dirt/.test(normalized) ? 'clean'
  : /corrosion|contaminant/.test(normalized) ? 'layers'
  : 'shield';
---

<svg class="coating-feature-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
  {kind === 'hardness' && (
    <>
      <path d="M12 3 20 6v5c0 5-3.4 8.3-8 10-4.6-1.7-8-5-8-10V6l8-3Z"></path>
      <path d="m8.5 12 2.2 2.2 4.8-5"></path>
    </>
  )}
  {kind === 'water' && (
    <>
      <path d="M12 3s5 5.8 5 10a5 5 0 0 1-10 0c0-4.2 5-10 5-10Z"></path>
      <path d="M9.5 14.2c.6 1.3 1.7 1.9 3.2 1.8"></path>
    </>
  )}
  {kind === 'gloss' && (
    <>
      <path d="m12 3 1.3 4.2L17.5 9l-4.2 1.8L12 15l-1.3-4.2L6.5 9l4.2-1.8L12 3Z"></path>
      <path d="m18.5 14 .7 2.3 2.3.7-2.3.7-.7 2.3-.7-2.3-2.3-.7 2.3-.7.7-2.3Z"></path>
    </>
  )}
  {kind === 'refresh' && (
    <>
      <path d="M19 8a8 8 0 1 0 1 7"></path>
      <path d="M19 3v5h-5"></path>
      <path d="m12 8 1 2.8L16 12l-3 1.2L12 16l-1-2.8L8 12l3-1.2L12 8Z"></path>
    </>
  )}
  {kind === 'clean' && (
    <>
      <path d="M5 18h14"></path>
      <path d="M7 15h10l2-8H5l2 8Z"></path>
      <path d="m9 4 .7 1.8L12 6.5l-2.3.7L9 9l-.7-1.8L6 6.5l2.3-.7L9 4Z"></path>
    </>
  )}
  {kind === 'layers' && (
    <>
      <path d="m12 4 8 4-8 4-8-4 8-4Z"></path>
      <path d="m4 12 8 4 8-4"></path>
      <path d="m4 16 8 4 8-4"></path>
    </>
  )}
  {kind === 'shield' && (
    <>
      <path d="M12 3 20 6v5c0 5-3.4 8.3-8 10-4.6-1.7-8-5-8-10V6l8-3Z"></path>
      <path d="M12 8v7"></path>
      <path d="M8.5 11.5h7"></path>
    </>
  )}
</svg>
