---
import { siFacebook, siInstagram, siTiktok } from 'simple-icons';

interface Props {
  settings: Record<string, any>;
  class?: string;
}

const { settings, class: className = '' } = Astro.props;
const socialLinks = [
  { label: 'Facebook', href: settings.facebookUrl, icon: siFacebook },
  { label: 'Instagram', href: settings.instagramUrl, icon: siInstagram },
  { label: 'TikTok', href: settings.tiktokUrl, icon: siTiktok },
].filter((link) => link.href);
---

<nav class:list={['social-links', className]} aria-label="Social media">
  {socialLinks.map((link) => (
    <a
      href={link.href}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`Follow Triple III Window Tint on ${link.label} (opens in a new tab)`}
      title={link.label}
    >
      <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
        <path d={link.icon.path}></path>
      </svg>
    </a>
  ))}
</nav>
