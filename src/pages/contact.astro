---
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { getPage, getSiteContent } from '../lib/content';
import { breadcrumbSchema, webPageSchema } from '../lib/seo';
const { settings } = await getSiteContent();
const page = await getPage('contact');
const seoTitle = page.seoTitle || `Window Tint Quote Mansfield TX | ${settings.businessName}`;
const seoDescription = page.seoDescription || `Call or text ${settings.businessName} for an automotive, residential, or commercial window tint quote in Mansfield, Texas.`;
const schema = [
  webPageSchema('ContactPage', seoTitle, seoDescription, '/contact'),
  breadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'Contact', path: '/contact' }]),
];
---
<BaseLayout title={seoTitle} description={seoDescription} settings={settings} schema={schema}>
  <section class="page-hero"><p class="eyebrow">{page.eyebrow}</p><h1>{page.headline}</h1><p>{page.intro}</p></section>
  <section class="section contact-grid">
    <div class="contact-panel"><p class="eyebrow">Book directly</p><h2>Call or text Triple III.</h2><a class="contact-action" href={`tel:${settings.phoneHref}`}>Call {settings.phoneDisplay}</a><a class="contact-action" href={`sms:${settings.phoneHref}`}>Text {settings.phoneDisplay}</a></div>
    <div class="contact-panel"><p class="eyebrow">Visit the shop</p><h2>Mansfield, Texas</h2><p>{settings.address}</p><p class="business-hours">{settings.hours}</p><a href={settings.googleMapsUrl}>Open in Google Maps →</a></div>
    <div class="contact-panel contact-social"><p class="eyebrow">Follow our work</p><h2>See what we’re tinting.</h2><p>Follow Triple III for recent projects, shop updates, and more.</p><SocialLinks settings={settings} /></div>
  </section>
</BaseLayout>
