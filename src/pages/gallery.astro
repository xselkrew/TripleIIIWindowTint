---
import BaseLayout from '../layouts/BaseLayout.astro';
import InfiniteGallery from '../components/ui/3d-gallery-photography';
import { getGallery, getPage, getSiteContent } from '../lib/content';
const { settings } = await getSiteContent();
const page = await getPage('gallery');
const gallery = await getGallery();
---
<BaseLayout title={`Gallery | ${settings.businessName}`} description="Recent automotive, residential, and commercial window tint work." settings={settings}>
  <section class="page-hero"><p class="eyebrow">{page.eyebrow}</p><h1>{page.headline}</h1><p>{page.intro}</p></section>
  {gallery.length ? (
    <section class="section gallery-experience">
      <InfiniteGallery
        client:only="react"
        images={gallery.map((item: any) => ({
          id: item._id,
          carouselUrl: item.carouselUrl,
          viewerUrl: item.viewerUrl,
          alt: item.alt || item.title,
        }))}
        speed={1.2}
        zSpacing={3}
        visibleCount={12}
        falloff={{ near: 0.8, far: 14 }}
      >
        <div slot="fallback" class="gallery-static-grid">
          {gallery.map((item: any) => (
            <a href={item.viewerUrl}>
              <img src={item.carouselUrl} alt={item.alt || item.title} loading="lazy" />
            </a>
          ))}
        </div>
      </InfiniteGallery>
    </section>
  ) : (
    <section class="section empty-gallery"><p class="eyebrow">New projects coming soon</p><h2>Follow our work as the gallery grows.</h2><p>Call or text to ask about recent projects like yours.</p><div class="button-row"><a class="button" href={`tel:${settings.phoneHref}`}>Call {settings.phoneDisplay}</a><a class="button button-ghost" href={`sms:${settings.phoneHref}`}>Text us</a></div></section>
  )}
</BaseLayout>
