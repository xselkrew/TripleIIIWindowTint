---
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import InfiniteGallery from '../components/ui/3d-gallery-photography';
import { getGallery, getPage, getSiteContent } from '../lib/content';
import { breadcrumbSchema, webPageSchema } from '../lib/seo';
const { settings } = await getSiteContent();
const page = await getPage('gallery');
const gallery = await getGallery();
const seoTitle = page.seoTitle || `Window Tint Gallery Mansfield TX | ${settings.businessName}`;
const seoDescription = page.seoDescription || 'View automotive, residential, and commercial window tint projects from Triple III Window Tint in Mansfield, Texas.';
const galleryImages = gallery.slice(0, 20).map((item: any) => ({
  '@type': 'ImageObject',
  name: item.title,
  description: item.description,
  contentUrl: item.viewerUrl,
  thumbnailUrl: item.carouselUrl,
  representativeOfPage: false,
}));
const schema = [
  {
    ...webPageSchema('ImageGallery', seoTitle, seoDescription, '/gallery'),
    associatedMedia: galleryImages,
  },
  breadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'Gallery', path: '/gallery' }]),
];
---
<BaseLayout
  title={seoTitle}
  description={seoDescription}
  settings={settings}
  socialImage="/og.png"
  socialImageAlt={`${settings.businessName} — Mansfield, Texas`}
  schema={schema}
>
  <section class="page-hero"><p class="eyebrow">{page.eyebrow}</p><h1>{page.headline}</h1><p>{page.intro}</p></section>
  {gallery.length ? (
    <section class="section gallery-experience">
      <InfiniteGallery
        client:only="react"
        images={gallery.map((item: any) => ({
          id: item._id,
          carouselUrl: item.carouselUrl,
          viewerUrl: item.viewerUrl,
          alt: item.alt || item.title,
        }))}
        speed={1.2}
        zSpacing={3}
        visibleCount={12}
        falloff={{ near: 0.8, far: 14 }}
      >
        <div slot="fallback" class="gallery-static-grid">
          {gallery.map((item: any) => (
            <a href={item.viewerUrl}>
              <img src={item.carouselUrl} alt={item.alt || item.title} loading="lazy" />
            </a>
          ))}
        </div>
      </InfiniteGallery>
    </section>
  ) : (
    <section class="section empty-gallery"><p class="eyebrow">New projects coming soon</p><h2>Follow our work as the gallery grows.</h2><p>See recent projects on social media, or call or text to ask about work like yours.</p><SocialLinks settings={settings} class="gallery-social" /><div class="button-row"><a class="button" href={`tel:${settings.phoneHref}`}>Call {settings.phoneDisplay}</a><a class="button button-ghost" href={`sms:${settings.phoneHref}`}>Text us</a></div></section>
  )}
</BaseLayout>
