---
import CTA from '../components/CTA.astro';
import TintOptionCard from '../components/TintOptionCard.astro';
import TintSqueegeeSlider from '../components/TintSqueegeeSlider.astro';
import { ShaderBackground } from '../components/ui/istanblue';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPage, getSiteContent } from '../lib/content';

const { settings, tintOptions, reviews } = await getSiteContent();
const [residentialPage, commercialPage] = await Promise.all([
  getPage('residential-tint'),
  getPage('commercial-tint'),
]);
const siteOrigin = Astro.url.origin;
const videoUrl = `https://www.youtube.com/embed/${settings.heroVideoId}?autoplay=1&mute=1&controls=0&loop=1&playlist=${settings.heroVideoId}&playsinline=1&modestbranding=1&rel=0&disablekb=1&fs=0&iv_load_policy=3&origin=${encodeURIComponent(siteOrigin)}`;
const videoPoster = `https://i.ytimg.com/vi/${settings.heroVideoId}/maxresdefault.jpg`;
---
<BaseLayout
  title={`${settings.businessName} | Mansfield Automotive Window Tint`}
  description="Automotive, residential, and commercial window tint installed in Mansfield, Texas."
  settings={settings}
>
  <div class="hero-stage">
  <section class="hero" style={`--hero-poster: url("${videoPoster}")`}>
    <iframe
      src={videoUrl}
      title="Automotive window tinting background video"
      allow="autoplay; encrypted-media"
      referrerpolicy="strict-origin-when-cross-origin"
      tabindex="-1"
      aria-hidden="true"
    ></iframe>
    <div class="hero-shade"></div>
    <div class="hero-content">
      <h1>{settings.heroTitle}</h1>
      <p>{settings.heroCopy}</p>
      <div class="button-row">
        <a class="button" href={`tel:${settings.phoneHref}`}>{settings.phoneDisplay}</a>
        <a class="button button-ghost" href={`sms:${settings.phoneHref}`}>Text us</a>
      </div>
    </div>
  </section>
  </div>

  <section class="trust-strip" aria-label="Business highlights">
    <span class="trust-item">
      <svg class="trust-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <circle cx="12" cy="12" r="5"></circle>
        <path d="M12 2v4M12 18v4M2 12h4M18 12h4"></path>
        <circle cx="12" cy="12" r="1"></circle>
      </svg>
      Precision installation
    </span>
    <a class="trust-item trust-item-warranty" href="/disclaimers" aria-label="Lifetime warranty available; review warranty terms">
      <svg class="trust-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M12 3 20 6v5c0 5-3.4 8.3-8 10-4.6-1.7-8-5-8-10V6l8-3Z"></path>
        <path d="m8.5 12 2.2 2.2 4.8-5"></path>
      </svg>
      Lifetime warranty available
    </a>
    <span class="trust-item">
      <svg class="trust-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M20 10c0 5.2-8 11-8 11S4 15.2 4 10a8 8 0 1 1 16 0Z"></path>
        <circle cx="12" cy="10" r="2.5"></circle>
      </svg>
      Mansfield, Texas
    </span>
  </section>

  <section class="section">
    <div class="section-heading">
      <p class="eyebrow">Three levels. One clean finish.</p>
      <h2>Choose your window tint.</h2>
      <p>From essential privacy to premium heat rejection, we’ll help you match the right film to your vehicle and budget.</p>
    </div>
    <div class="card-grid tint-card-grid">
      {tintOptions.map((option: any, index: number) => (
        <TintOptionCard option={option} index={index} />
      ))}
    </div>
  </section>

  <TintSqueegeeSlider settings={settings} options={tintOptions} />

  <section class="warranty section">
    <ShaderBackground className="warranty-shader" client:load />
    <div class="warranty-content">
      <p class="eyebrow">Built for the long haul</p>
      <h2>{settings.warrantyTitle}</h2>
      <p>{settings.warrantyCopy}</p>
      <a href="/disclaimers">Review warranty terms →</a>
    </div>
    <div class="warranty-mark warranty-content">
      <img src="/lifetime-warranty.png" alt="Lifetime warranty" loading="lazy" />
    </div>
  </section>

  <section class="section property-tint-preview">
    <div class="section-heading">
      <p class="eyebrow">Tint beyond the road</p>
      <h2>Better glass for Mansfield spaces.</h2>
      <p>Bring glare control, daytime privacy, and a polished finish to the windows where you live and work.</p>
    </div>
    <div class="property-tint-grid">
      {[
        { page: residentialPage, href: '/residential-tint', label: 'Residential Tint' },
        { page: commercialPage, href: '/commercial-tint', label: 'Commercial Tint' },
      ].map(({ page, href, label }) => (
        <article class="property-tint-card">
          <img src={page.imageUrl} alt={page.imageAlt || ''} width="1200" height="800" loading="lazy" />
          <div>
            <p class="eyebrow">{label}</p>
            <h3>{page.headline}</h3>
            <p>{page.intro}</p>
            <a class="text-link" href={href}>Explore {label.toLowerCase()} →</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section reviews">
    <div class="reviews-intro">
      <div class="section-heading">
        <p class="eyebrow">100% Real customer feedback</p>
        <h2>
          Mansfield drivers recommend
          <span class="review-arrow-anchor">
            us.
            <svg class="review-arrow" viewBox="0 0 270 145" fill="none" aria-hidden="true">
              <defs>
                <marker id="review-arrowhead" markerWidth="10" markerHeight="10" refX="7" refY="5" orient="auto">
                  <path d="M1 1 8 5 1 9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
                </marker>
              </defs>
              <path class="review-arrow-desktop" d="M12 12C112 4 220 8 238 66C248 99 242 119 232 132" marker-end="url(#review-arrowhead)"></path>
              <path class="review-arrow-mobile" d="M12 12C94 4 154 10 158 66C160 101 125 122 84 132" marker-end="url(#review-arrowhead)"></path>
            </svg>
          </span>
        </h2>
      </div>
    </div>
    <div class="review-grid">
      {reviews.map((review: any) => (
        <blockquote>
          <div class="stars" aria-label={`${review.rating || 5} out of 5 stars`}>★★★★★</div>
          <p>“{review.quote}”</p>
          <cite>{review.name} · Google review</cite>
        </blockquote>
      ))}
    </div>
    <a class="button button-ghost" href={settings.googleMapsUrl}>View our Google listing</a>
  </section>

  <CTA settings={settings} />

  <script>
    const featuredTintCards = document.querySelectorAll<HTMLElement>('[data-tint-card="featured"]');
    featuredTintCards.forEach((featuredTintCard) => {
      let isOnscreen = false;
      const syncEdgeAnimation = () =>
        featuredTintCard.classList.toggle('edge-active', isOnscreen && !document.hidden);
      const observer = new IntersectionObserver(([entry]) => {
        isOnscreen = entry?.isIntersecting ?? false;
        syncEdgeAnimation();
      }, { rootMargin: '80px' });
      observer.observe(featuredTintCard);
      document.addEventListener('visibilitychange', syncEdgeAnimation);
    });
  </script>
</BaseLayout>
