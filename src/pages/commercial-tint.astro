---
import PropertyTintPage from '../components/PropertyTintPage.astro';
import { getPage, getSiteContent } from '../lib/content';

const { settings } = await getSiteContent();
const page = await getPage('commercial-tint');
const benefits = [
  'Control glare across customer and employee spaces',
  'Reduce ultraviolet exposure to furnishings and displays',
  'Add privacy without sacrificing a professional appearance',
  'Create a consistent finish across storefront and office glass',
];
---

<PropertyTintPage
  settings={settings}
  page={page}
  serviceName="Commercial Tint"
  description="Commercial window tint for Mansfield, Texas storefronts and offices, providing glare control, daytime privacy, UV protection, and a polished finish."
  benefits={benefits}
  path="/commercial-tint"
/>
