---
import SocialLinks from '../components/SocialLinks.astro';

interface Props {
  title: string;
  description: string;
  settings: Record<string, any>;
  robots?: string;
  socialImage?: string;
  socialImageAlt?: string;
  schema?: Record<string, any> | Record<string, any>[];
}

const {
  title,
  description,
  settings,
  robots = 'index,follow',
  socialImage = '/og.png',
  socialImageAlt = `${settings.businessName} in Mansfield, Texas`,
  schema = [],
} = Astro.props;
const mapEmbedUrl = `https://www.google.com/maps?q=${encodeURIComponent(settings.address)}&output=embed`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const socialImageUrl = new URL(socialImage, Astro.site ?? Astro.url.origin);
const origin = (Astro.site ?? Astro.url).origin;
const socialProfiles = [
  settings.facebookUrl,
  settings.instagramUrl,
  settings.tiktokUrl,
].filter(Boolean);
const businessSchema = {
  '@context': 'https://schema.org',
  '@type': 'AutomotiveBusiness',
  '@id': `${origin}/#business`,
  name: settings.businessName,
  url: `${origin}/`,
  logo: `${origin}/logo.webp`,
  image: socialImageUrl.href,
  telephone: settings.phoneHref,
  address: {
    '@type': 'PostalAddress',
    streetAddress: '1275 N Main St #505',
    addressLocality: 'Mansfield',
    addressRegion: 'TX',
    postalCode: '76063',
    addressCountry: 'US',
  },
  openingHours: ['Mo-Sa 09:00-18:00', 'Su 10:00-18:00'],
  hasMap: settings.googleMapsUrl,
  sameAs: socialProfiles,
};
const pageSchemas = Array.isArray(schema) ? schema : [schema];
const jsonLd = JSON.stringify([businessSchema, ...pageSchemas].filter(Boolean)).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#050607" />
    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={settings.businessName} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <script is:inline type="application/ld+json" set:html={jsonLd}></script>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/styles.css" />
    <link rel="stylesheet" href="/launch.css?v=20260728-social-icons" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label={`${settings.businessName} home`}>
        <img src="/logo.webp" width="512" height="512" alt="" />
        <span>{settings.businessName}</span>
      </a>
      <button class="menu-toggle" aria-expanded="false" aria-controls="site-nav">Menu</button>
      <nav id="site-nav" aria-label="Main navigation">
        <a href="/tint-options">Tint options</a>
        <a href="/residential-tint">Residential</a>
        <a href="/commercial-tint">Commercial</a>
        <a href="/gallery">Gallery</a>
        <a href="/about">About</a>
        <a href="/contact">Contact</a>
        <a class="button button-small" href={`tel:${settings.phoneHref}`}>{settings.phoneDisplay}</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-details">
        <a class="footer-brand" href="/">{settings.businessName}</a>
        <p>{settings.address}</p>
        <p class="business-hours">{settings.hours}</p>
        <SocialLinks settings={settings} class="footer-social" />
      </div>
      <div class="footer-map">
        <iframe
          src={mapEmbedUrl}
          title={`Map and directions to ${settings.businessName}`}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
        <a href={settings.googleMapsUrl} target="_blank" rel="noopener noreferrer">
          Open directions in Google Maps ↗
        </a>
      </div>
      <div class="footer-links footer-legal">
        <a href="/disclaimers">Disclaimers</a>
      </div>
    </footer>
    <script>
      const toggle = document.querySelector('.menu-toggle');
      const nav = document.querySelector('#site-nav');
      toggle?.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!open));
        nav?.classList.toggle('is-open', !open);
      });
    </script>
  </body>
</html>
